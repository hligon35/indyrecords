{
  "expo": {
    "name": "IRM RMS Prototype",
    "slug": "irm-rms-prototype",
    "scheme": "irmrmsdemo",
    "version": "0.1.0",
    "icon": "./assets/irm-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphazonelabs.irmrmsdemo",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.alphazonelabs.irmrmsdemo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/irm-adaptive-icon.png",
        "backgroundColor": "#00113f"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "../../assets/icons/32x32.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow IRM RMS to scan fictional bin barcodes.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-loopback-network.cjs"
    ]
  }
}
