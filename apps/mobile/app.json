{
  "expo": {
    "name": "IRM RMS Prototype",
    "slug": "irm-rms-prototype",
    "scheme": "irmrmsdemo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alphazonelabs.irmrmsdemo"
    },
    "android": {
      "package": "com.alphazonelabs.irmrmsdemo",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow IRM RMS to scan fictional bin barcodes.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
