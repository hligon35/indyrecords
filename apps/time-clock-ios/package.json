{
  "name": "irm-time-clock-ios",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "doctor": "expo-doctor",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:development": "eas build --platform ios --profile development",
    "build:ios:production": "eas build --platform ios --profile production",
    "ota:preview": "eas update --channel preview --platform ios --message \"IRM Time Clock preview update\"",
    "ota:production": "eas update --channel production --platform ios --message \"IRM Time Clock production update\""
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-constants": "~18.0.0",
    "expo-updates": "~29.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "expo-doctor": "^1.17.0",
    "eas-cli": "^27.10.0"
  }
}
