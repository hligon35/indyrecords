{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRM RMS Prototype",
  "version": "0.1.0",
  "identifier": "com.alphazonelabs.irmrms.prototype",
  "build": {
    "frontendDist": "../../../dist/web",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "node ../../scripts/serve-web.mjs",
    "beforeBuildCommand": "node ../../scripts/build-web.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "IRM RMS Prototype",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:8787 http://127.0.0.1:8787; object-src 'none'; base-uri 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "irmrmsdesktop"
        ]
      }
    }
  }
}
