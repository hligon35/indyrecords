{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRM RMS Prototype",
  "version": "0.1.0",
  "identifier": "com.alphazonelabs.irmrms.prototype",
  "build": {
    "frontendDist": "../../../dist/web",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../../scripts/build-web.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "IRM RMS Prototype",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}
